#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    if(n<=1)
    {
        cout << "not prime";
        return 0;
    }
    bool isprime=true;
    for(int i=2;i<n;i++)
        {
            if(n%i==0)
            {
                isprime=false;
                break;
            }
        }
    if(isprime)
    {
        cout << "yes prime";
    }
    else
    {
        cout << "not a prime";
    }
    return 0;
}
