#include<bits/stdc++.h>
using namespace std;
int main()
{
     string s;
     cin >> s;
     int i=0;
     int j=s.length()-1;
    while(i<=j)
        {
            if(tolower(s[i])!=tolower(s[j]))
            {
                cout << "Not Palindrome";
                return 0;
            }
         i++;
         j--;
        }
    cout << "Palindrome";
    return 0;
}
