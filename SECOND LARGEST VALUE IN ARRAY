#include <bits/stdc++.h>
using namespace std;
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    int fl = INT_MIN; 
    int sl = INT_MIN; 
    for (int i = 0; i < n; i++) {
        if (arr[i] > fl) {
            sl = fl;       
            fl = arr[i];   
        } else if (arr[i] > sl && arr[i] != fl) {
            sl = arr[i];   
        }
    }
    if (sl == INT_MIN) {
        cout << "No second largest element found";
    } else {
        cout << sl;
    }
    return 0;
}
