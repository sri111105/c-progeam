#include <bits/stdc++.h> 
using namespace std;
int main() {
    vector<int> v = {1, 2, 3, 4, 5};
    int k;
    cout << "Enter number of right rotations: ";
    cin >> k;

    int n = v.size();
    k = k % n; 
    rotate(v.begin(), v.end() - k, v.end());
    cout << "After Right Rotation: ";
    for (int x : v) {
        cout << x << " ";
    }
    return 0;
}
